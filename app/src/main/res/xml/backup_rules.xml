<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 (API 30) and older.
   See https://developer.android.com/guide/topics/data/autobackup
   Android 12+ uses data_extraction_rules.xml instead.
   Only <exclude> is used, so everything else is still backed up.
-->
<full-backup-content>
    <!-- Login credentials: Spotify sp_dc cookie, Deezer ARL, SpotiFLAC session -->
    <exclude domain="sharedpref" path="spotify_session.xml"/>
    <exclude domain="sharedpref" path="Deezer.xml"/>
    <exclude domain="sharedpref" path="SpotiflacSession.xml"/>
</full-backup-content>
